    {
      "parameters": {
        "jsCode": "const REQUIRED = [\n  'lead_score',\n  'qualification',\n  'priority',\n  'business_need',\n  'recommended_action',\n  'ai_reason'\n];\n\nconst first = $input.first().json;\n\nlet raw = first.content?.parts?.[0]?.text ?? '';\n\nraw = String(raw)\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\nconst start = raw.indexOf('{');\nconst end = raw.lastIndexOf('}');\n\nif (start === -1 || end === -1) {\n  throw new Error('AI response contains no JSON object');\n}\n\nlet data;\n\ntry {\n  data = JSON.parse(raw.slice(start, end + 1));\n} catch (error) {\n  throw new Error('AI response is not valid JSON: ' + error.message);\n}\n\nconst missing = REQUIRED.filter(key => !(key in data));\n\nif (missing.length) {\n  throw new Error('Missing AI fields: ' + missing.join(', '));\n}\n\ndata.priority = String(data.priority).toLowerCase();\n\nif (!['high', 'medium', 'low'].includes(data.priority)) {\n  data.priority = 'medium';\n}\n\ndata.qualification = String(data.qualification).toLowerCase();\n\nif (!['hot', 'warm', 'cold'].includes(data.qualification)) {\n  data.qualification = 'warm';\n}\n\ndata.lead_score = Math.max(\n  0,\n  Math.min(100, Number(data.lead_score) || 0)\n);\n\nreturn [{\n  json: {\n    ...$('Webhook').first().json.body,\n    ...data\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        -208
      ],
      "id": "f5ec7ac0-9147-4a8f-be9f-ead2d3ee87a0",
      "name": "Parse JSON",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst execId = $execution.id ?? `test${Date.now()}`;\n\nreturn items.map((item, i) => {\n  const today = new Date();\n\n  const yyyy = today.getFullYear();\n  const mm = String(today.getMonth() + 1).padStart(2, '0');\n  const dd = String(today.getDate()).padStart(2, '0');\n\n  const dateStr = yyyy + mm + dd;\n\n  return {\n    json: {\n      ...item.json,\n      lead_id: `LEAD-${dateStr}-${execId}-${i + 1}`,\n      date: today.toLocaleDateString()\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
