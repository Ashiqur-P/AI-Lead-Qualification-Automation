    {
      "parameters": {
        "jsCode": "const lead = $('Webhook').first().json.body ?? {};\n\nconst executionId = $execution.id ?? `test${Date.now()}`;\n\nconst today = new Date();\nconst yyyy = today.getFullYear();\nconst mm = String(today.getMonth() + 1).padStart(2, '0');\nconst dd = String(today.getDate()).padStart(2, '0');\nconst dateStr = yyyy + mm + dd;\n\nreturn [\n  {\n    json: {\n      lead_id: `LEAD-${dateStr}-${executionId}-UNSCORED`,\n      date: today.toLocaleDateString(),\n      name: lead.name ?? '',\n      email: lead.email ?? '',\n      company: lead.company ?? '',\n      message: lead.message ?? '',\n      budget: lead.budget ?? '',\n      timeline: lead.timeline ?? '',\n      lead_score: '',\n      qualification: 'unscored',\n      priority: 'medium',\n      business_need: '',\n      recommended_action: 'Review this lead manually',\n      ai_reason: 'AI scoring failed; saved without a score'\n    }\n  }\n];"
      },
